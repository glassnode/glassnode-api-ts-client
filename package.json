{
  "name": "glassnode-api",
  "version": "0.30.1",
  "type": "commonjs",
  "description": "TypeScript client for the Glassnode API (Node.js and browsers)",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "dist/glassnode-api.umd.min.js",
  "module": "./dist/esm/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/esm/package.json",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glassnode/glassnode-api-ts-client.git"
  },
  "bugs": {
    "url": "https://github.com/glassnode/glassnode-api-ts-client/issues"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:cjs && pnpm run build:esm",
    "build:browser": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:x402": "vitest run test/x402.integration.spec.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run build:browser",
    "preversion": "pnpm run lint",
    "version": "pnpm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('node:fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'})+'\\n')\"",
    "docs": "typedoc"
  },
  "keywords": [
    "glassnode",
    "api",
    "client",
    "typescript",
    "javascript",
    "node",
    "browser",
    "crypto",
    "on-chain",
    "data",
    "analytics",
    "financial",
    "market",
    "indicators",
    "metrics"
  ],
  "author": {
    "name": "Jordi Planadecursach",
    "email": "jordi.planadecusach@glassnode.com",
    "url": "https://github.com/planadecu"
  },
  "contributors": [
    {
      "name": "Glassnode AG",
      "url": "https://glassnode.com"
    }
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "homepage": "https://github.com/glassnode/glassnode-api-ts-client#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./x402": {
      "import": {
        "types": "./dist/esm/x402.d.ts",
        "default": "./dist/esm/x402.js"
      },
      "require": {
        "types": "./dist/x402.d.ts",
        "default": "./dist/x402.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@x402/fetch": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "viem": "^2.48.11"
  },
  "peerDependenciesMeta": {
    "@x402/fetch": {
      "optional": true
    },
    "@x402/evm": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^18.19.130",
    "@vitest/coverage-v8": "^5.0.0",
    "@x402/evm": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "rollup": "^4.63.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-zod": "^1.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "viem": "^2.56.5",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ],
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "picomatch": ">=4.0.4",
      "flatted": ">=3.4.2",
      "brace-expansion@5": ">=5.0.9",
      "postcss": ">=8.5.23",
      "@humanfs/node": ">=0.16.8"
    }
  },
  "typesVersions": {
    "*": {
      "x402": [
        "./dist/x402.d.ts"
      ]
    }
  }
}
